# ---------------------------------------------------------------------------
# kernel-dm-toolbox environment
#
# Copy to `.env.local` for local development. Every variable here is declared
# and validated in `src/env.ts` — add it there first, or it will not be read.
# One container is run per campaign, so these values describe a single campaign.
# ---------------------------------------------------------------------------

# libSQL / SQLite connection string.
#
# A relative `file:` path is resolved against the server's working directory.
# That is the project root under `pnpm dev`, but the standalone production
# server chdir's into `.next/standalone` — so `pnpm start` absolutises this
# against the project root for you, and Docker passes an absolute /data path.
# If you launch the server any other way, make this absolute.
DATABASE_URL="file:.data/kernel-dm-toolbox.db"

# Only needed when pointing DATABASE_URL at a remote libSQL server instead of a
# local file. Leave unset for the default single-container setup.
# DATABASE_AUTH_TOKEN=""

# Campaign name. Shown in the browser tab; there is no in-app banner.
CAMPAIGN_NAME="Untitled Campaign"

# Whether an instance whose library is empty imports it on boot.
#
# NOT a feature gate, and the opposite way round: unset means ON, because a
# container started with nothing but `docker run` has no other way to get a
# creature library. Set it to "false" for an instance that must not reach
# GitHub at startup — the creature browser then shows its empty state until
# `pnpm db:import` is run by hand.
LIBRARY_AUTO_IMPORT="true"

# Absolute origin of this instance. Used to build absolute tRPC URLs during a
# server render. On a LAN box this is typically http://<host-ip>:3000.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Feature gates ---------------------------------------------------------
# Server-only, evaluated in `src/flags.ts`. Compared against the literal
# string "true", so anything else (including unset) means off. Changing one
# needs a restart.

# The initiative tracker.
FEATURE_INITIATIVE_TRACKER="false"

# --- Escape hatch ----------------------------------------------------------
# Set to 1 to skip env validation entirely. Used by lint, typecheck, Storybook
# and the Docker build, where real values are absent. Never set in production.
# SKIP_ENV_VALIDATION=1
