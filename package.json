{
  "name": "kernel-dm-toolbox",
  "version": "1.1.0",
  "description": "A self-hosted dungeon master's toolbox for a single tabletop campaign: initiative tracker, spell lookup and virtual tabletop, run from one Docker container with a read-only second screen for the table.",
  "private": true,
  "license": "MIT",
  "author": "Ramon Gebben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamonGebben/kernel-dm-toolbox.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:import": "tsx src/server/db/import.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "rm -f .data/kernel-dm-toolbox.db && pnpm db:migrate && pnpm db:import",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@libsql/client": "0.18.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "client-only": "0.0.1",
    "drizzle-orm": "0.45.2",
    "immer": "11.1.18",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "superjson": "2.2.6",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-storybook": "10.6.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.10.0"
}
